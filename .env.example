# Local SQLite file. Not a secret. Tests can override this with a temporary path.
BOND_DB_PATH=data/bond.db

# Optional. Used to sign share links. When unset, Bond uses a documented
# local fallback and says so on the share panel. Set a unique value of at
# least 16 characters before anyone else uses this server. Do not commit a
# real secret.
# BOND_SHARE_SECRET=
